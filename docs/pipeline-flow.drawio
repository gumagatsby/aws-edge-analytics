<mxfile host="drawio"><diagram name="Daily pipeline"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="640" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1560" height="640" as="geometry"/></mxCell><mxCell id="c4" value="The daily pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c5" value="Step Functions, started at 05:00 UTC. Each day is replaced whole, so a re-run gives identical tables." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Resolve&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Which days to process: yesterday, or a range for a backfill&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Ensure&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda, Athena]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Create any missing tables&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Each day, one at a time (Map)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="1040" height="250" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Process&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Glue 5.0 Spark job]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Parse 33 fields. Quarantine bad lines with a reason. IP to /24 or /48, visitor = HMAC. Bot and device rules. Data Quality rules. Raw = clean + quarantined, or fail.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="285" y="150" width="250" height="170" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Load fact&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda, Athena SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Delete the day from fact_request, insert it again&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="575" y="150" width="210" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Aggregate&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda, Athena SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Rebuild the day in 7 report tables: cost, edges, countries, cache, A/B, bots, errors&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="825" y="150" width="210" height="170" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Reconcile&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda, Athena]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Clean rows = fact rows = report rows, or fail&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1075" y="150" width="200" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Publish&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Lambda]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Write insights/data.json, invalidate it in CloudFront&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="190" height="170" as="geometry"/></mxCell><mxCell id="c14" value="Done" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="400" width="80" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Notify&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[SNS (KMS)]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Execution name, error and cause, to the alerts topic&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="210" height="100" as="geometry"/></mxCell><mxCell id="c16" value="Failed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;fontColor=#D13212;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="480" width="80" height="40" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8235;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="any step fails, after retries" style="html=1;endArrow=block;endFill=1;strokeColor=#D13212;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="370" as="sourcePoint"/><mxPoint x="685" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D13212;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Also on failure: a CloudWatch alarm on failed executions sends to the same topic, and an SQS queue keeps every alert. On a real failure during the build, the alert arrived 70 seconds after the run stopped (requirement: 15 minutes)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1480" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>